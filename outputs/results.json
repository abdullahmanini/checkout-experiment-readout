  "compiled_sql_example": "-- Checkout conversion: Share of customers who reached checkout and placed at least one order.\nSELECT variant AS variant,\n       SUM(converted) AS converted_customers,\n       SUM(1) AS customers,\n       1.0 * SUM(converted) / NULLIF(SUM(1), 0) AS checkout_conversion\nFROM exp_customers\nWHERE exposed = 1 AND excluded_reason IS NULL\nGROUP BY variant\nORDER BY variant;\n"
}